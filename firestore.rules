rules_version = '2';

// Reglas de seguridad de Firestore — NegocioApp v1.4.0
//
// Modelo de seguridad:
// - Sin sesión → acceso denegado a todo.
// - CEO (email hardcodeado) → lectura total, escritura plena en businesses.
// - Admin/Worker → acceso solo a los negocios listados en users/{uid}.businessIds.
//
// Aislamiento por negocio:
//   users/{uid}.businessIds es un array mantenido por la app que lista todos
//   los businessId a los que pertenece el usuario (se añade al invitar/migrar).
//   Las reglas usan get() sobre ese documento para verificar pertenencia.
//   Esto es seguro porque solo la app (autenticada) puede escribir ese campo,
//   y las reglas de users/{uid} solo permiten escritura al propio usuario o CEO.
//
// Integridad contable:
//   Sales y fiado_payments son append-only para no-CEO (no se pueden editar
//   ni borrar una vez creados).

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isCeo() {
      return signedIn()
        && request.auth.token.email == 'antonio.geldes1701@gmail.com';
    }

    // Verifica que el usuario tenga acceso al negocio dado.
    // Lee users/{uid}.businessIds (array) y comprueba que businessId esté ahí.
    function canAccessBusiness(businessId) {
      return isCeo() || (
        signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('businessIds', []).hasAny([businessId])
      );
    }

    // ── Negocios ─────────────────────────────────────────────────────────────

    match /businesses/{businessId} {
      // Cualquier sesión activa puede leer negocios (menú de selección, preview CEO).
      allow read: if signedIn();
      // Solo el CEO crea, edita y borra negocios.
      allow create, update, delete: if isCeo();
    }

    // ── Perfiles de usuario ───────────────────────────────────────────────────

    match /users/{uid} {
      // Cada usuario solo lee y escribe su propio perfil; el CEO puede leer todo.
      allow read: if signedIn() && (request.auth.uid == uid || isCeo());
      allow write: if signedIn() && (request.auth.uid == uid || isCeo());
    }

    // ── Membresías ────────────────────────────────────────────────────────────

    match /memberships/{membershipId} {
      // Cada usuario lee solo sus propias membresías (por email).
      allow read: if signedIn() && (
        isCeo() ||
        resource.data.email == request.auth.token.email
      );
      // Escritura permitida si el usuario pertenece al negocio de la membresía.
      // El rol (solo admins invitan) se valida en la app; aquí validamos pertenencia.
      allow write: if signedIn() && (
        isCeo() ||
        canAccessBusiness(request.resource.data.businessId)
      );
    }

    // ── Productos ─────────────────────────────────────────────────────────────

    match /products/{productId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId);
      allow update: if canAccessBusiness(resource.data.businessId)
                    && canAccessBusiness(request.resource.data.businessId);
      allow delete: if canAccessBusiness(resource.data.businessId);
    }

    // ── Ventas (append-only para no-CEO) ─────────────────────────────────────

    match /sales/{saleId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      // Al crear: el userId debe corresponder al usuario autenticado.
      allow create: if canAccessBusiness(request.resource.data.businessId)
                    && request.resource.data.userId == request.auth.uid;
      // Las ventas no se editan ni borran (integridad contable).
      allow update, delete: if isCeo();
    }

    // ── Clientes (fiados) ─────────────────────────────────────────────────────

    match /clients/{clientId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId);
      allow update: if canAccessBusiness(resource.data.businessId);
      allow delete: if canAccessBusiness(resource.data.businessId);
    }

    // ── Pagos de fiados (append-only para no-CEO) ─────────────────────────────

    match /fiado_payments/{paymentId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId);
      // Los pagos no se editan ni borran (integridad contable).
      allow update, delete: if isCeo();
    }

    // ── Catch-all: denegar todo lo demás ─────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
