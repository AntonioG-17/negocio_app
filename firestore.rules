rules_version = '2';

// Reglas de seguridad de Firestore — NegocioApp v1.4.3
//
// canAccessBusiness() verifica pertenencia en orden de precedencia:
//   1. CEO → siempre pasa
//   2. businessIds array (nuevo modelo) → si existe y contiene el businessId
//   3. businessId string (modelo legacy) → fallback para cuentas existentes
//      que aún no tienen el array (se puebla la próxima vez que se invita/migra)
//
// Esto evita que usuarios existentes queden bloqueados al actualizar las reglas.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCeo() {
      return signedIn()
        && request.auth.token.email == 'antonio.geldes1701@gmail.com';
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function canAccessBusiness(businessId) {
      return isCeo() || (
        signedIn() && (
          userDoc().get('businessIds', []).hasAny([businessId]) ||
          userDoc().get('businessId', '') == businessId
        )
      );
    }

    // ── Negocios ─────────────────────────────────────────────────────────────

    match /businesses/{businessId} {
      allow read: if signedIn();
      allow create, update, delete: if isCeo();
    }

    // ── Perfiles de usuario ───────────────────────────────────────────────────

    match /users/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isCeo());
    }

    // ── Membresías ────────────────────────────────────────────────────────────

    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        isCeo() ||
        resource.data.email == request.auth.token.email
      );
      allow write: if signedIn() && (
        isCeo() ||
        canAccessBusiness(request.resource.data.businessId)
      );
    }

    // ── Productos ─────────────────────────────────────────────────────────────

    match /products/{productId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId);
      allow update: if canAccessBusiness(resource.data.businessId)
                    && canAccessBusiness(request.resource.data.businessId);
      allow delete: if canAccessBusiness(resource.data.businessId);
    }

    // ── Ventas (append-only para no-CEO) ─────────────────────────────────────

    match /sales/{saleId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId)
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isCeo();
    }

    // ── Clientes ─────────────────────────────────────────────────────────────

    match /clients/{clientId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId);
      allow update: if canAccessBusiness(resource.data.businessId);
      allow delete: if canAccessBusiness(resource.data.businessId);
    }

    // ── Pagos de fiados (append-only para no-CEO) ─────────────────────────────

    match /fiado_payments/{paymentId} {
      allow read:   if canAccessBusiness(resource.data.businessId);
      allow create: if canAccessBusiness(request.resource.data.businessId);
      allow update, delete: if isCeo();
    }

    // ── Catch-all ─────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
